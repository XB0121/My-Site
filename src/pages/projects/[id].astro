---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { site, base, imageUrl, contentHtml } from '../../lib/site';
export function getStaticPaths() { return site.projects.map(project => ({ params: { id: String(project.id) }, props: { project } })); }
const { project } = Astro.props;
---
<SiteLayout title={`${project.title} · ${site.settings.site_name}`} description={project.excerpt}>
  <article class="detail-page page-width"><a class="text-link" href={`${base}#projects`}>← 返回项目</a><p class="eyebrow">{project.category || 'PROJECT'} {project.year && ` / ${project.year}`}</p><h1>{project.title}</h1><p class="detail-lead">{project.excerpt}</p>{project.image && <img class="detail-cover" src={imageUrl(project.image.url)} alt={project.image.alt || project.title} />}<div class="rich-content" set:html={contentHtml(project.content)} />{project.url && <a class="button button-dark" href={project.url} target="_blank" rel="noopener noreferrer">访问项目 <span aria-hidden="true">↗</span></a>}</article>
</SiteLayout>
