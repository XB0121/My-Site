---
import posts from '../../data/posts.json';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { site, base, contentHtml } from '../../lib/site';
export function getStaticPaths() { return posts.map(post => ({ params: { id: String(post.id) }, props: { post } })); }
const { post } = Astro.props;
---
<SiteLayout title={`${post.title.replace(/<[^>]*>/g, '')} · ${site.settings.site_name}`}>
  <article class="detail-page page-width"><a class="text-link" href={`${base}#articles`}>← 返回文章</a><p class="eyebrow">JOURNAL / {post.date.slice(0, 10)}</p><h1 set:html={post.title} /><div class="rich-content" set:html={contentHtml(post.content)} /></article>
</SiteLayout>
