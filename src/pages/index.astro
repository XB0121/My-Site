---
import SiteLayout from '../layouts/SiteLayout.astro';
import HeroArt from '../components/HeroArt.astro';
import { site, base, imageUrl, contentHtml } from '../lib/site';
import posts from '../data/posts.json';
const s = site.settings;
---
<SiteLayout>
  <section class="hero page-width" id="home" aria-labelledby="hero-title">
    <div class="hero-copy"><p class="eyebrow"><span class="tiny-line"></span>{s.hero_eyebrow}</p><h1 id="hero-title">{s.hero_title}<br /><em>{s.hero_accent}</em></h1><p class="hero-description">{s.hero_description}</p><div class="hero-actions"><a class="button button-dark" href="#projects">{s.hero_button}<span aria-hidden="true">↗</span></a><a class="text-link" href="#about">{s.hero_secondary}<span aria-hidden="true">→</span></a></div></div>
    <div class="hero-visual">{s.hero_image ? <img class="hero-photo" src={imageUrl(s.hero_image.url)} alt={s.hero_image.alt} fetchpriority="high" /> : <HeroArt />}</div>
    <a class="hero-scroll" href="#projects"><span>SCROLL TO EXPLORE</span><span aria-hidden="true">↓</span></a>
  </section>
  <section class="projects-section section-space" id="projects" aria-labelledby="projects-title"><div class="page-width"><div class="section-heading"><div><p class="eyebrow">01 / SELECTED PROJECTS</p><h2 id="projects-title">{s.projects_title}</h2></div><p class="section-description">{s.projects_description}</p></div>
    {site.projects.length ? <div class="project-grid">{site.projects.map((project, i) => <a class="project-card" href={`${base}projects/${project.id}/`}><div class="project-cover">{project.image ? <img src={imageUrl(project.image.url)} alt={project.image.alt || project.title} loading="lazy" /> : <div class={`project-placeholder variation-${i % 3}`} aria-hidden="true"><span>{String(i + 1).padStart(2, '0')}</span><span>↗</span></div>}</div><div class="project-meta"><span>{project.category || 'PROJECT'}</span><span>{project.year}</span></div><h3>{project.title}<span aria-hidden="true">↗</span></h3><p>{project.excerpt}</p></a>)}</div> : <div class="project-empty"><span class="empty-symbol" aria-hidden="true">✳</span><div><h3>下一个作品，正在发生。</h3><p>给想法一点时间，给创造留一点空间。</p></div><a class="text-link" href="#contact">一起聊聊<span aria-hidden="true">↗</span></a></div>}
  </div></section>
  <section class="about-section section-space page-width" id="about" aria-labelledby="about-title"><div class="about-visual">{s.about_image ? <img src={imageUrl(s.about_image.url)} alt={s.about_image.alt} loading="lazy" /> : <div class="about-art" aria-hidden="true"><span class="about-star">✳</span><span>Always<br /><em>curious.</em></span><div class="about-art-caption">LEARN. MAKE. REPEAT.</div></div>}</div><div class="about-copy"><p class="eyebrow">02 / {s.about_eyebrow}</p><h2 id="about-title">{s.about_title}</h2><div class="plain-text">{s.about_text}</div><a class="text-link" href="#contact">与我联络<span aria-hidden="true">↗</span></a></div></section>
  {posts.length > 0 && <section class="journal-section page-width section-space" id="articles" aria-labelledby="journal-title"><div class="section-heading"><div><p class="eyebrow">NOTES ALONG THE WAY</p><h2 id="journal-title">探索与记录</h2></div><span class="journal-count">JOURNAL / {String(posts.length).padStart(2, '0')}</span></div><div class="journal-list">{posts.map(post => <a class="journal-row" href={`${base}posts/${post.id}/`}><time datetime={post.date}>{post.date.slice(0, 10)}</time><div><h3 set:html={post.title} /><div class="excerpt" set:html={contentHtml(post.excerpt)} /></div><span aria-hidden="true">↗</span></a>)}</div></section>}
  <section class="contact-section" id="contact" aria-labelledby="contact-title"><div class="page-width contact-inner"><div><p class="eyebrow">03 / LET’S CONNECT</p><h2 id="contact-title">{s.contact_title}</h2><p>{s.contact_text}</p></div><div class="contact-links">{s.contact_email && <a href={`mailto:${s.contact_email}`}><span>EMAIL</span><strong>{s.contact_email}</strong><span aria-hidden="true">↗</span></a>}{s.contact_wechat && <div class="contact-wechat"><span>WECHAT</span><strong>{s.contact_wechat}</strong></div>}{s.contact_social_url && <a href={s.contact_social_url} target="_blank" rel="noopener noreferrer"><span>ELSEWHERE</span><strong>{s.contact_social_label || 'Social'}</strong><span aria-hidden="true">↗</span></a>}</div></div></section>
</SiteLayout>
